{
  "id": "wl-ci-investigate",
  "name": "WL · CI failure → fix ticket",
  "description": "The CI investigator finds and diagnoses failing GitHub Actions runs, the product owner specs the fix ticket in the owning lane, and triage checks it. The fix is then built with that lane's build flow and merged after a green draft PR.",
  "tags": [
    "workoutlab",
    "ci"
  ],
  "nodes": [
    {
      "id": "investigate",
      "agentId": "wl-ci-investigator",
      "label": "investigate",
      "dependsOn": [],
      "inputMapping": {
        "repoPath": "$input.repoPath",
        "ticket": "$input.ticket",
        "task": "$input.task"
      },
      "position": {
        "x": 80,
        "y": 80
      }
    },
    {
      "id": "spec",
      "agentId": "wl-product-owner-ci-spec",
      "label": "spec",
      "dependsOn": [
        "investigate"
      ],
      "inputMapping": {
        "repoPath": "$input.repoPath",
        "ticket": "$input.ticket",
        "task": "$input.task",
        "investigate": "investigate"
      },
      "position": {
        "x": 340,
        "y": 220
      }
    },
    {
      "id": "check",
      "agentId": "wl-triage-check",
      "label": "check",
      "dependsOn": [
        "spec"
      ],
      "inputMapping": {
        "repoPath": "$input.repoPath",
        "ticket": "$input.ticket",
        "task": "$input.task",
        "spec": "spec"
      },
      "position": {
        "x": 600,
        "y": 360
      }
    }
  ]
}
