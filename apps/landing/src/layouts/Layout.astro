---
import "@workoutlab/design-tokens/fonts.css";
import "@workoutlab/design-tokens/tokens.css";
import "../styles/global.css";
import { tokens } from "@workoutlab/design-tokens";
import displayFontUrl from "@workoutlab/design-tokens/fonts/big-shoulders-display-latin-wght.woff2?url";
import bodyFontUrl from "@workoutlab/design-tokens/fonts/dm-sans-latin-wght.woff2?url";

interface Props {
  title: string;
  description: string;
  /** Path this page canonicalises to, e.g. "/" or "/privacy/". Omit for pages
   * (like 404) that shouldn't advertise a canonical URL. */
  canonicalPath?: string;
}

const { title, description, canonicalPath } = Astro.props;
const canonicalUrl = canonicalPath ? new URL(canonicalPath, Astro.site) : undefined;
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content={tokens.color.bg} />
    <link rel="preload" as="font" type="font/woff2" crossorigin href={displayFontUrl} />
    <link rel="preload" as="font" type="font/woff2" crossorigin href={bodyFontUrl} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    {canonicalUrl && <link rel="canonical" href={canonicalUrl.toString()} />}
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <slot />
  </body>
</html>
