---
import Layout from "../layouts/Layout.astro";
import { landing } from "../content/landing";

// No canonical: a 404 page has no canonical URL of its own (AC7/AC15).
---

<Layout title={`${landing.notFound.title} — workout LAB by Uptive`} description={landing.notFound.body}>
  <main id="main" class="not-found wrap">
    <h1>{landing.notFound.title}</h1>
    <p class="body">{landing.notFound.body}</p>
    <p><a class="home-link" href="/">{landing.notFound.homeLinkLabel}</a></p>
  </main>
</Layout>
