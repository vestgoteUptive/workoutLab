---
import Layout from "../layouts/Layout.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import { landing } from "../content/landing";
import { appUrl } from "../lib/app-url";
import heroSetUrl from "../assets/hero-set.webp?url";

// D-0046 §5: PUBLIC_APP_URL is resolved once, at build time. An invalid value
// throws here and fails the build (AC10).
// The hero image is the decorative Set screen (UF-09.3, lift state), exported 2x from the
// Cobalt canvas option 1b (T-0584 AC5); the hero text carries the meaning.
const ctaHref = appUrl(import.meta.env.PUBLIC_APP_URL);
---

<Layout title={landing.meta.title} description={landing.meta.description} canonicalPath="/">
  <SiteHeader />

  <main id="main">
    <section class="hero wrap">
      <div class="hero-copy">
        <h1>{landing.hero.headline}</h1>
        <div class="hero-bottom">
          <p class="sub">{landing.hero.sub}</p>
          <div class="cta-stack">
            <a class="cta" data-cta="primary" href={ctaHref}>{landing.hero.ctaLabel}</a>
            <p class="cta-note">{landing.hero.ctaNote}</p>
          </div>
        </div>
      </div>
      <div class="hero-phone">
        <img src={heroSetUrl} width="340" height="640" alt="" aria-hidden="true" decoding="async" />
      </div>
    </section>

    <section class="features wrap">
      <h2>{landing.featuresHeading}</h2>
      <div class="feature-grid">
        {
          landing.features.map((feature) => (
            <article class="feature-card">
              <h3>{feature.title}</h3>
              <p>{feature.body}</p>
            </article>
          ))
        }
      </div>
    </section>

    <section class="privacy-band">
      <div class="privacy-grid wrap">
        <h2>{landing.privacy.heading}</h2>
        <div class="privacy-text">
          <p>{landing.privacy.summary}</p>
          <a href="/privacy/">{landing.privacy.linkLabel}</a>
        </div>
      </div>
    </section>
  </main>

  <SiteFooter />
</Layout>
